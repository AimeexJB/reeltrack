# ---- TMDB (required) ----------------------------------------------------------
# Get a free token at https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (long JWT). A short v3 "API Key" also works.
VITE_TMDB_TOKEN=

# ---- Supabase (optional — turns on accounts + cloud sync) ---------------------
# Leave blank to keep everything in this browser. See SUPABASE_SETUP.md.
# Supabase dashboard → your project → Connect (or Project Settings → API Keys).
# Use the PUBLISHABLE key (sb_publishable_…) or the legacy "anon" key.
# NEVER put the secret / service_role key here — anything starting with VITE_ is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
