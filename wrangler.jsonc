// Cloudflare deployment config (Worker + static assets). See the README's "Deploying" section.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reeltrack",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (e.g. /tv/123) serve index.html so the React router can handle them.
    "not_found_handling": "single-page-application",
    // The Worker runs first so it can strip the /reeltracker prefix and proxy TMDB.
    "run_worker_first": true
  },
  // Only this path on the domain comes here; the rest of (www.)aimeeredmond.com is the portfolio.
  // The site's main address is www — requests to the bare domain are redirected there by the Worker.
  "routes": [
    { "pattern": "www.aimeeredmond.com/reeltracker*", "zone_name": "aimeeredmond.com" },
    { "pattern": "aimeeredmond.com/reeltracker*", "zone_name": "aimeeredmond.com" }
  ],
  "workers_dev": false,
  // Keep variables/secrets added in the Cloudflare dashboard (e.g. TMDB_TOKEN) when deploying from Git.
  "keep_vars": true,
  // Per-visitor limit on the TMDB proxy: 300 requests a minute is plenty for normal browsing
  // (a busy page makes ~10–30), but stops anyone using the proxy to drain the TMDB quota.
  "ratelimits": [{ "name": "TMDB_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "observability": { "enabled": true }
}
